# Environment Configuration for AI Design Suite
# Copy this file to .env and configure your settings

# ============================================================================
# LLM Configuration
# ============================================================================

# LLM Provider: 'azure_ai_foundry', 'openai', 'local', or 'mock'
LLM_PROVIDER=mock

# Azure AI Foundry Configuration (recommended for production)
# AZURE_AI_ENDPOINT=https://your-project.inference.ai.azure.com
# AZURE_AI_MODEL_DEPLOYMENT=your-model-deployment-name

# OpenAI Configuration
# OPENAI_API_KEY=your-openai-api-key-here

# Local LLM Configuration (e.g., Ollama)
# LOCAL_LLM_ENDPOINT=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.2

# ============================================================================
# Application Configuration
# ============================================================================

# Application Environment
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Storage Paths
CAD_TEMP_DIR=./temp
OUTPUT_DIR=./outputs
SESSION_DIR=./sessions

# ============================================================================
# Database Configuration (if implementing persistent storage)
# ============================================================================

# DATABASE_URL=sqlite:///./ai_design_suite.db

# ============================================================================
# External Service Configuration
# ============================================================================

# CAD Service Configuration
# FREECAD_PATH=/path/to/freecad
# AUTOCAD_CORE_CONSOLE_PATH=/path/to/accoreconsole

# Supplier Database Configuration
# SUPPLIER_DB_API_KEY=your-supplier-api-key
# SUPPLIER_DB_ENDPOINT=https://api.supplier-service.com

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=./logs/ai_design_suite.log

# ============================================================================
# Security Configuration (for production)
# ============================================================================

# SECRET_KEY=your-secret-key-here
# ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.com

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable features during development
ENABLE_VOICE_INTERFACE=false
ENABLE_CLOUD_CAD_PROCESSING=false
ENABLE_ADVANCED_FEA=false
ENABLE_REAL_SUPPLIER_DB=false

# ============================================================================
# Development Settings
# ============================================================================

# Debug mode (do not use in production)
DEBUG=true

# Mock data for development
USE_MOCK_SUPPLIERS=true
USE_MOCK_CAD_CONVERTER=true
USE_MOCK_FEA_SOLVER=true